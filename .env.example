# --- Supabase (project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Prefer the publishable key from the Supabase dashboard (newer projects).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Legacy name; still supported if PUBLISHABLE_KEY is unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Service-role key — server-only, never expose to the browser.
# Required for invite-by-email flow (admin.inviteUserByEmail).
# Find it in: Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_SECRET"

# Site URL — used to build invite redirect links.
# Local: http://localhost:3000   Production: https://rosterlylineups.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase Postgres (Prisma) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase Auth redirects ---
# Add http://localhost:3000/auth/callback and your production /auth/callback
# under Authentication → URL configuration.

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-...

# --- Resend (reminders, support, etc.) ---
# Get from resend.com → API Keys
RESEND_API_KEY=re_...
# Optional override; default is Rosterly <support@rosterlylineups.app> (must be verified in Resend)
# RESEND_FROM_EMAIL="Rosterly <support@rosterlylineups.app>"

# --- Cron security ---
# A long random secret that protects /api/cron/reminders from public access.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here

# --- Twilio (optional — text/SMS reminders) ---
# Leave blank to disable SMS; reminders will just skip the SMS channel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
