// Prisma connects to your Supabase Postgres `public` schema.
// Migrations use DIRECT_URL (port 5432).
// The app uses DATABASE_URL (pooler, port 6543) for serverless-friendly pooling.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Team {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String
  year         String   @default("")
  season       String
  division     String
  ageGroup     String   @map("age_group")
  teamType     String   @map("team_type")
  organization String?
  isActive     Boolean  @default(true) @map("is_active")
  isArchived   Boolean  @default(false) @map("is_archived")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rosters Roster[]
  events  Event[]
  members TeamMember[]

  @@map("teams")
}

model TeamMember {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String
  invitedBy  String?  @map("invited_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Roster {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  teamId     String?  @map("team_id") @db.Uuid
  name       String
  season     String
  year       String   @default("")
  isActive   Boolean  @default(true) @map("is_active")
  isArchived Boolean  @default(false) @map("is_archived")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team    Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  players Player[]
  events  Event[]

  @@map("rosters")
}

model Event {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  teamId     String?   @map("team_id") @db.Uuid
  rosterId   String?   @map("roster_id") @db.Uuid
  /// FK to game_lineups — managed as a raw UUID (game_lineups is a raw-SQL table)
  lineupId   String?   @map("lineup_id") @db.Uuid
  type       String    @default("game")
  title      String
  opponent   String?
  eventDate  DateTime  @map("event_date") @db.Date
  startTime  String?   @map("start_time")
  endTime    String?   @map("end_time")
  location   String?
  notes      String?
  rsvpDeadlineAt DateTime? @map("rsvp_deadline_at") @db.Timestamptz(6)
  isHome     Boolean   @default(true) @map("is_home")
  isArchived Boolean   @default(false) @map("is_archived")

  recurrenceType     String?   @map("recurrence_type")
  recurrenceEndDate  DateTime? @map("recurrence_end_date") @db.Date
  recurrenceGroupId  String?   @map("recurrence_group_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  team   Team?   @relation(fields: [teamId],   references: [id], onDelete: SetNull)
  roster Roster? @relation(fields: [rosterId], references: [id], onDelete: SetNull)

  @@map("events")
}

model Player {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  rosterId            String   @map("roster_id") @db.Uuid
  firstName           String   @map("first_name")
  lastName            String   @map("last_name")
  preferredName       String?  @map("preferred_name")
  jerseyNumber        String?  @map("jersey_number")
  dateOfBirth         DateTime? @map("date_of_birth") @db.Date
  bats                String?
  throws              String?
  primaryPositions    String[] @map("primary_positions")
  secondaryPositions  String[] @map("secondary_positions")
  isActive            Boolean  @default(true) @map("is_active")
  parentGuardianName  String?  @map("parent_guardian_name")
  parentGuardianEmail String?  @map("parent_guardian_email")
  parentGuardianPhone String?  @map("parent_guardian_phone")
  medicalNotes        String?  @map("medical_notes")
  uniformSize         String?  @map("uniform_size")
  notes               String?
  claimedByUserId     String?  @map("claimed_by_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roster Roster        @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  claims PlayerClaim[]

  @@map("players")
}

model Profile {
  userId    String   @id @map("user_id") @db.Uuid
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  phone     String?
  address   String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

model PlayerClaim {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  status    String   @default("pending")
  message   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, userId])
  @@map("player_claims")
}

/// 1:1 messages between users who share at least one team (see RLS).
model DirectMessage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId    String   @map("sender_id") @db.Uuid
  recipientId String   @map("recipient_id") @db.Uuid
  senderName  String   @map("sender_name")
  body        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([senderId, recipientId, createdAt(sort: Asc)])
  @@index([recipientId, senderId, createdAt(sort: Asc)])
  @@map("direct_messages")
}
